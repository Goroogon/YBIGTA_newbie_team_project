# === LLM ===
ANTHROPIC_API_KEY=
# 생략 시 기본값(claude-sonnet-5) 사용
ANTHROPIC_MODEL=

# === MCP Server (팀원 B에게 전달받는 값) ===
# 둘 중 하나라도 비어있으면 자동으로 Mock MCP 클라이언트(lib/mcp/mock-client.ts)가 사용됩니다.
# 예: https://mcp.example.com  또는 http://<EC2 Public IP>  (nginx가 80/443에서 프록시)
MCP_SERVER_URL=
MCP_AUTH_TOKEN=

# 주의: 이 파일의 모든 값은 서버 사이드(app/api/chat/route.ts, lib/*)에서만 사용됩니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요 — 붙이면 브라우저 번들에 노출됩니다.
